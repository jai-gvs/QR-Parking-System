<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- lets the app run on a newer installed .NET runtime (9, 10, ...) -->
    <RollForward>Major</RollForward>
    <AssemblyName>BcpParking.Api</AssemblyName>
    <RootNamespace>BcpParking.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.*" />
    <PackageReference Include="Isopoh.Cryptography.Argon2" Version="1.1.*" />
  </ItemGroup>

</Project>
